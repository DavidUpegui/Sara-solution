# Copy this file to `.env.local` and fill in your own key:
#
#   cp .env.example .env.local
#
# The values below are placeholders and must be replaced.

# Required. DeepSeek API key used for AI classification and draft generation.
# Create one at https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-key

# Optional. Google Gemini key. Only used if you switch composition/email.ts
# back to the Gemini adapters (not used by the default DeepSeek wiring).
# GEMINI_API_KEY=your-gemini-key
